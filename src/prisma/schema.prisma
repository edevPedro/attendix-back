generator client {
  provider = "prisma-client-js"
}

datasource postgresql {
  provider = "postgresql"
  url      = env("POSTGRESQL_URL")
}

model WaChat {
  id               Int             @id @default(autoincrement())
  jid              String          @unique
  name             String
  kind             String
  enabled          Boolean         @default(false)
  discordChannelId String?
  sendAsAudio      Boolean         @default(false)
  lastSeen         DateTime        @default(now())
  listId           Int?
  list             BroadcastList?  @relation(fields: [listId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([enabled])
  @@index([discordChannelId])
  @@index([listId])
}

model BroadcastList {
  id               Int      @id @default(autoincrement())
  name             String
  discordChannelId String   @unique
  sendAsAudio      Boolean  @default(false)
  chats            WaChat[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Message {
  id               Int      @id @default(autoincrement())
  jid              String
  direction        String
  type             String
  body             String?
  mediaPath        String?
  transcript       String?
  discordMessageId String?
  waMessageId      String?  @unique
  rawJson          Json?
  createdAt        DateTime @default(now())

  @@index([jid, createdAt])
  @@index([discordMessageId])
  @@map("gateway_messages")
}

model AdminSession {
  token     String   @id
  username  String
  expiresAt DateTime

  @@index([expiresAt])
}
